# Copie para .env e preencha. NUNCA versione o .env real.

APP_NAME="Milly Rodrigues API"

# False em produção. True apenas em desenvolvimento local.
DEBUG=False

# OBRIGATÓRIO em produção. Gere um valor aleatório e único:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# O app se recusa a subir com valores placeholder ou prefixo 'django-insecure-'.
SECRET_KEY="GERE-UMA-CHAVE-ALEATORIA-UNICA"

# Banco. Sem esta variável usa SQLite local.
DATABASE_URL="postgres://usuario:senha@host:5432/nome_do_banco"

# Hosts HTTP aceitos (separados por vírgula).
ALLOWED_HOSTS="seu-dominio.com,api.seu-dominio.com"

# Origens CORS liberadas (JSON array de strings). Vazio/ inválido em produção = nenhuma.
ALLOWED_ORIGINS='["https://seu-front.com"]'

# WhatsApp (Evolution API)
WHATSAPP_PROVIDER="evolution"
WHATSAPP_API_URL="https://sua-evolution-api"
WHATSAPP_API_KEY="CHAVE-FORTE-DA-EVOLUTION-API"
WHATSAPP_INSTANCE="milly-rodrigues"

# Negócio e portal de agendamento
BUSINESS_NAME="Milly Rodrigues — Depilação & Estética"
BOOKING_URL="https://seu-front.com/agendar"
PUBLIC_PORTAL_BASE_URL="https://seu-front.com"

# InfinitePay (pagamento antecipado no agendamento). Opcional.
# A InfiniteTag também pode ser definida pelo admin em Configurações (tem prioridade).
INFINITEPAY_HANDLE="SEU_IDENTIFICADOR_INFINITEPAY"
# URL pública da API (usada para montar o webhook_url do checkout).
# Se vazio, é derivada da própria requisição.
PUBLIC_API_BASE_URL="https://api.seu-dominio.com"

# Storage de backups (S3 compatível). Opcional.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME="auto"
AWS_S3_ENDPOINT_URL=""

# HTTPS redirect (produção). Deixe True atrás de proxy TLS.
SECURE_SSL_REDIRECT=True
